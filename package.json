{
  "name": "profitmind-forex",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "postinstall": "npm install --prefix server && npm install --prefix client",
    "dev": "concurrently -n server,client -c auto \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix server && npm run build --prefix client",
    "test": "npm run test --prefix server",
    "verify": "npm run build && npm test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
